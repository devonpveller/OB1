# Preview front proxy. Serves the test harness at / and proxies /workbench/* to
# the workbench (injecting X-Brain-Key, just like the portal does in prod), so
# the browser hits everything same-origin. PREVIEW ONLY — no Authelia.
:8080 {
	handle /workbench/* {
		reverse_proxy preview-workbench:8000 {
			header_up X-Brain-Key {$WORKBENCH_KEY}
		}
	}
	# Silence the browser's automatic favicon probe (cosmetic).
	handle /favicon.ico {
		respond 204
	}
	handle {
		root * /srv
		file_server
	}
}
