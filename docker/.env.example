# Open Brain (OB1) self-hosted stack — environment template.
#
#   cp .env.example .env       then fill in real values.
#
# The real .env is gitignored; THIS template is safe to commit.
# Generate the secrets with the commands shown (any equivalent works).
#
# NOTE ON BLAST RADIUS: most variables below reach exactly the services that
# substitute them by name. `open_notebook` is the exception - it carries
# `env_file: ./.env` (docker-compose.yml:1252-1253), so the WHOLE of this file
# is injected into that one container as environment. Only 4 of the 25 names
# declared here are actually substituted into open_notebook (its own SURREAL_*
# and OPEN_NOTEBOOK_* keys); the other 21 belong to other services and reach it
# anyway. Worth knowing before you add anything sensitive here.

# Compose profiles started by a bare `docker compose up -d` here. Unset = core
# only (20 services); the four below render the full 30. See README.md, "Compose
# profiles" — note a CLI `--profile` REPLACES this list rather than adding to it.
#COMPOSE_PROFILES=research,wiki,notebook,idea-refinery

# Auth key for the MCP servers — sent by clients as the `x-brain-key`
# header or `?key=`. Used by openbrain-mcp, openbrain-ext, and the mcpo
# bridge configs.
#   openssl rand -hex 32
MCP_ACCESS_KEY=REPLACE_WITH_64_HEX_CHARS

# PostgreSQL superuser password for openbrain-db.
#   openssl rand -hex 16
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Bearer token Open WebUI uses to authenticate TO the mcpo bridges
# (this is NOT the x-brain-key; mcpo holds that internally).
#   openssl rand -hex 24
MCPO_API_KEY=REPLACE_WITH_48_HEX_CHARS

# Bearer token cloud services (Claude Code, ChatGPT, etc.) use to
# authenticate TO the privacy-enforcing openbrain-gateway at
# 127.0.0.1:8061. The gateway holds the real MCP_ACCESS_KEY; cloud
# clients never see it. Mirrors mnemory's MNEMORY_GATEWAY_KEY.
#   openssl rand -base64 32
OPENBRAIN_GATEWAY_KEY=REPLACE_WITH_GATEWAY_BEARER_TOKEN
# The OPS door (127.0.0.1:8062, agent-memory tools for host processes).
# A SEPARATE key from the cloud door's - sharing one would mean a cloud
# credential could reach the agent-memory tools the cloud door denies.
OPS_GATEWAY_KEY=REPLACE_WITH_OPS_BEARER_TOKEN

# Single-user scope for all extension data. Any UUID.
#   uuidgen     (Linux/macOS)  |  [guid]::NewGuid() (PowerShell)
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000

# ── Wiki compile schedule (OPTIONAL — sensible defaults; override here
#    or in your shell. The compose file reads ${WIKI_*:-default}.) ─────
# Timezone the daily compile hour is interpreted in. IANA name (handles
# EST/EDT etc. automatically). Default: US Eastern.
WIKI_TZ=America/New_York
# Hour (0-23, local to WIKI_TZ) of the deterministic daily compile.
WIKI_RECOMPILE_HOUR=1
# Change-driven recompile after research/sources settle (debounced).
WIKI_WATCH_ENABLED=true
WIKI_WATCH_INTERVAL_MIN=3
# Compile once when the openbrain-wiki container (re)starts.
WIKI_COMPILE_ON_BOOT=true

# ── Agent-memory recall tuning (memory-plane PLAN §3 — OPTIONAL, and
#    DELIBERATELY BLANK. Leave them blank until the corpus is measured.) ─
# Raw-cosine floor for recall. BLANK = no floor. Do NOT copy upstream's
# 0.7: it was tuned for text-embedding-3-small, and against our bge-m3
# lane related items land around 0.4-0.6, so 0.7 returns nothing — the
# failure that looks exactly like success. Calibrate first; the procedure
# is in ai-stack documentation/notes/agent-memory-recall-threshold.md.
AGENT_MEMORY_RECALL_MIN_SIMILARITY=
# Recency blend weight, 0..1. BLANK/0 = pure similarity (what ships).
# score = sim*(1-w) + exp(-age/half_life)*w
AGENT_MEMORY_RECALL_RECENCY_WEIGHT=
# Days at which the recency term halves. Only meaningful when the weight
# is non-zero. BLANK = 30.
AGENT_MEMORY_RECALL_HALF_LIFE_DAYS=

# Password the application role uses to reach openbrain-db (ai-stack item
# sl-ob1-docs). REQUIRED: compose substitutes it with NO default at NINE sites
# (eight in docker-compose.yml, one in docker-compose.scheduled.yml), every one
# of them a DB_PASSWORD.
#
# HOW TO TELL IF IT IS MISSING. With the line below absent from your `.env`,
# every `docker compose config` warns once per site - NINE times - and renders
# those nine services with a blank database password. The line is present in
# this template, so a `.env` seeded from it warns ZERO times. Warnings naming
# this variable therefore mean one thing: your `.env` has lost the line.
#
# A BLANK VALUE IS NOT THE SAME AS A MISSING ONE, and it is the quieter
# failure: `OB_APP_MEMORY_PASSWORD=` with nothing after it is a real
# declaration, so compose warns zero times and renders `DB_PASSWORD: ""` at
# every one of the nine sites (all nine appear in an all-four-profile render;
# five of them in a bare one). Put a value here.
OB_APP_MEMORY_PASSWORD=

# ── Backups, SurrealDB and Open Notebook (moved here 2026-09-20, ai-stack item
#    sl-ob1-docs). These were documented ONLY in ai-stack's pre-split root
#    .env.example and never in this file, although compose has always read them
#    from HERE: this project's directory is OB1/docker, so OB1/docker/.env is
#    the file it substitutes from. Every default below is the `${VAR:-default}`
#    the compose file actually carries, which is not always what the root
#    template said. ──────────────────────────────────────────────────────────

# OB1 PostgreSQL nightly logical dump (pg_dump -Fc, pgvector-preserving),
# run by openbrain-db-backup. All three backup scripts in ./backup run a
# PRECHECK before they touch any file: they log a `PRECHECK SKIP` line and
# exit 0 if the source data is missing/empty or a liveness probe to the source
# service fails (pg_isready here, the /health endpoint for surreal, a non-empty
# data dir holding .git for the wiki), so a broken service cannot overwrite a
# good snapshot with a torn one.
# Snapshots retained, most recent first. Compose default: 2.
OPENBRAIN_DB_BACKUP_RETAIN_COUNT=2
# Cron expression (container TZ is UTC). Compose default: 0 2 * * *.
OPENBRAIN_DB_BACKUP_CRON=0 2 * * *
# NOTE: POSTGRES_USER and POSTGRES_DB are NOT read from this file. The root
# template carried them (postgres / openbrain) with a warning that they must
# match what openbrain-db runs with, but compose sets both as LITERALS on
# openbrain-db and openbrain-db-backup — there is no ${POSTGRES_USER} or
# ${POSTGRES_DB} anywhere in either compose file. Setting them here has no
# effect; change them in docker-compose.yml or not at all. POSTGRES_PASSWORD
# (above) IS substituted and must be set.

# OB1 wiki backup (immutable git objects — a hot tar is safe). Tars the
# openbrain-wiki-data and wiki-assets volumes. `wiki` profile.
# Snapshots retained. Compose default: 2.
OPENBRAIN_WIKI_BACKUP_RETAIN_COUNT=2
# Sleep-loop interval in SECONDS, not a cron expression (crond misses
# fire-windows on Docker Desktop VM clock jumps). Compose default: 86400.
OPENBRAIN_WIKI_BACKUP_INTERVAL=86400

# Open Notebook: surreal export (logical) + notebook_data tar. `notebook`
# profile. See ai-stack documentation/runbooks/restore-from-snapshot.md.
# Snapshots retained. Compose default: 2.
OPEN_NOTEBOOK_BACKUP_RETAIN_COUNT=2
# Cron expression (container TZ is UTC). Compose default: 20 2 * * *.
OPEN_NOTEBOOK_BACKUP_CRON=20 2 * * *

# Host directory holding Open Notebook's surreal_data/ and notebook_data/
# (bind-mounted by surrealdb, open_notebook and open-notebook-backup).
# Compose default: ../../../open-notebook, resolved from OB1/docker/ - i.e. a
# folder named open-notebook BESIDE the ai-stack checkout. Set it to put the
# data anywhere else, e.g. /srv/open-notebook or D:\data\open-notebook.
OPEN_NOTEBOOK_DIR=

# Public base URL for the podcast email's episode links (openbrain-podcast):
# the Authelia-gated notebook host the portal serves, e.g.
# https://notebook.ai.example.com. No compose default; blank = no public
# links in the email, only the internal audio URL.
ON_PUBLIC_BASE=

# SurrealDB credentials — Open Notebook's local UI/queue/chat store.
# REQUIRED when the `notebook` profile is on: compose substitutes them with NO
# default into surrealdb's own `start --user/--pass`, into open_notebook and
# into open-notebook-backup, so a blank value starts the datastore with empty
# credentials. Note SurrealDB v2 only honours `start --user/--pass` on FIRST
# boot; an existing datastore keeps whatever user it was created with until a
# DEFINE USER pass rotates it.
SURREAL_USER=
SURREAL_PASSWORD=

# Open Notebook DB encryption key. REQUIRED when the `notebook` profile is on —
# substituted with no default; a blank value is passed through as blank.
OPEN_NOTEBOOK_ENCRYPTION_KEY=

# API key Open Notebook presents to the embedding endpoint. Compose default:
# `not-needed` (the local gateway ignores it) — the root template left this
# BLANK, which is not the same thing: a blank value here overrides the default
# and sends an empty key. Leave it unset to get `not-needed`, or set a real
# LiteLLM virtual key if the endpoint enforces one.
OPEN_NOTEBOOK_LLM_API_KEY=not-needed
