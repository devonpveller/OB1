# Open Brain (OB1) self-hosted stack — environment template.
#
#   cp .env.example .env       then fill in real values.
#
# The real .env is gitignored; THIS template is safe to commit.
# Generate the secrets with the commands shown (any equivalent works).

# Auth key for the MCP servers — sent by clients as the `x-brain-key`
# header or `?key=`. Used by openbrain-mcp, openbrain-ext, and the mcpo
# bridge configs.
#   openssl rand -hex 32
MCP_ACCESS_KEY=REPLACE_WITH_64_HEX_CHARS

# PostgreSQL superuser password for openbrain-db.
#   openssl rand -hex 16
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Bearer token Open WebUI uses to authenticate TO the mcpo bridges
# (this is NOT the x-brain-key; mcpo holds that internally).
#   openssl rand -hex 24
MCPO_API_KEY=REPLACE_WITH_48_HEX_CHARS

# Bearer token cloud services (Claude Code, ChatGPT, etc.) use to
# authenticate TO the privacy-enforcing openbrain-gateway at
# 127.0.0.1:8061. The gateway holds the real MCP_ACCESS_KEY; cloud
# clients never see it. Mirrors mnemory's MNEMORY_GATEWAY_KEY.
#   openssl rand -base64 32
OPENBRAIN_GATEWAY_KEY=REPLACE_WITH_GATEWAY_BEARER_TOKEN
# The OPS door (127.0.0.1:8062, agent-memory tools for host processes).
# A SEPARATE key from the cloud door's - sharing one would mean a cloud
# credential could reach the agent-memory tools the cloud door denies.
OPS_GATEWAY_KEY=REPLACE_WITH_OPS_BEARER_TOKEN

# Single-user scope for all extension data. Any UUID.
#   uuidgen     (Linux/macOS)  |  [guid]::NewGuid() (PowerShell)
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000

# ── Wiki compile schedule (OPTIONAL — sensible defaults; override here
#    or in your shell. The compose file reads ${WIKI_*:-default}.) ─────
# Timezone the daily compile hour is interpreted in. IANA name (handles
# EST/EDT etc. automatically). Default: US Eastern.
WIKI_TZ=America/New_York
# Hour (0-23, local to WIKI_TZ) of the deterministic daily compile.
WIKI_RECOMPILE_HOUR=1
# Change-driven recompile after research/sources settle (debounced).
WIKI_WATCH_ENABLED=true
WIKI_WATCH_INTERVAL_MIN=3
# Compile once when the openbrain-wiki container (re)starts.
WIKI_COMPILE_ON_BOOT=true

# ── Agent-memory recall tuning (memory-plane PLAN §3 — OPTIONAL, and
#    DELIBERATELY BLANK. Leave them blank until the corpus is measured.) ─
# Raw-cosine floor for recall. BLANK = no floor. Do NOT copy upstream's
# 0.7: it was tuned for text-embedding-3-small, and against our bge-m3
# lane related items land around 0.4-0.6, so 0.7 returns nothing — the
# failure that looks exactly like success. Calibrate first; the procedure
# is in ai-stack documentation/notes/agent-memory-recall-threshold.md.
AGENT_MEMORY_RECALL_MIN_SIMILARITY=
# Recency blend weight, 0..1. BLANK/0 = pure similarity (what ships).
# score = sim*(1-w) + exp(-age/half_life)*w
AGENT_MEMORY_RECALL_RECENCY_WEIGHT=
# Days at which the recency term halves. Only meaningful when the weight
# is non-zero. BLANK = 30.
AGENT_MEMORY_RECALL_HALF_LIFE_DAYS=
