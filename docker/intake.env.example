# docker/intake.env.example -> copy to docker/intake.env (gitignored) for the intake service
# (compose profile `intake`; security-hardening-2026-10 I5). Loaded by openbrain-intake ONLY
# (`env_file: intake.env`, required: false) - never put these in docker/.env, which
# open_notebook loads whole. The profile is OFF by default; this file is inert until the
# operator's gated deploy (integrations/intake/README.md, "What I5 ships"). The service REFUSES
# TO START with a blank caller-keys list or password.

# One key per calling connector, connector=key[,connector=key...]; a key is 32-256 printable
# characters with no blank, ',' or '='. The key decides which connector a caller may submit as.
#   openssl rand -hex 32     (one per connector)
INTAKE_CALLER_KEYS=change-me-research=REPLACE_WITH_64_HEX_CHARS
# Password of the `intake` DB role (created by integrations/intake/sql/init-intake.sql with NO
# password; the live apply of that migration is a gated deploy step). Set it once on the live
# DB, the same value here:
#   psql -U postgres -d openbrain -v ON_ERROR_STOP=1 -v intake_db_password="<this value>" -f init-intake.sql
#   openssl rand -hex 16
INTAKE_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# intake's OWN LiteLLM virtual key for the second opinion (metadata.lane ob-intake; issued in
# llm-gateway-ui - a gated step). Unset: every item that needs the second opinion expires
# `suspicious`, never clean.
INTAKE_SECOND_OPINION_KEY=REPLACE_WITH_SK_VIRTUAL_KEY
# Screening workers (each ~1.9 GB once loaded) and torch threads per worker.
#INTAKE_CLASSIFIER_WORKERS=1
#INTAKE_CLASSIFIER_THREADS=8
# Operator D40 = (a): clean (default) | suspicious.
#INTAKE_D2_WEAK_RULE_JUDGE_CLEAN=clean
