{
  "imports": {
    "hono": "jsr:@hono/hono@4.13.5",
    "hono/": "jsr:/@hono/hono@4.13.5/",
    "@hono/zod-openapi": "jsr:@hono/zod-openapi@1.6.3",
    "zod": "npm:zod@4.6.5",
    "postgres": "https://deno.land/x/postgres@v0.19.3/mod.ts",
    "@shared/slug": "file:///recipes/_shared/slug.mjs"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read src/main.ts",
    "contract:gen": "deno run --allow-read --allow-write --allow-env src/contracts/gen.ts",
    "contract:check": "deno run --allow-read --allow-env src/contracts/gen.ts --check"
  },
  "fmt": {
    "lineWidth": 100
  }
}
