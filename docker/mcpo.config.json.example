{
  "_comment": "Template for the CORE mcpo bridge (Open WebUI's open-brain tool server). Copy to mcpo.config.json and replace the placeholder with the MCP_PERSONAL_ACCESS_KEY value from .env - NOT MCP_ACCESS_KEY. That key opens the PERSONAL lane: every tool except agent_memory_* (memory-plane PLAN 1.1; amp-owui-deny). The real file is gitignored.",
  "mcpServers": {
    "open-brain": {
      "type": "streamable-http",
      "url": "http://openbrain-mcp:8000/",
      "headers": { "x-brain-key": "REPLACE_WITH_MCP_PERSONAL_ACCESS_KEY" }
    }
  }
}
