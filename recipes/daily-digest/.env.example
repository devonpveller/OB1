# Daily Digest — local self-hosted. No cloud LLM; mechanical formatting
# only. The only network egress is to Gmail (the user's own mailbox)
# and the local PostgREST proxy.

# Internal Docker DNS name for the local PostgREST proxy. Caddy strips
# Authorization/apikey, so no key is sent.
OPEN_BRAIN_URL=http://openbrain-rest

# Recipient — the user's own Gmail address. From defaults to the same.
DIGEST_TO=you@example.com
DIGEST_FROM=you@example.com

# Window of thoughts to include. The container is expected to run once
# daily near 07:00 local; 24h reaches the prior morning's captures plus
# any overnight imports from gmail-pull.
DIGEST_WINDOW_HOURS=24
DIGEST_LIMIT=200

# --- Self-hosted stack (OB1/docker/docker-compose.scheduled.yml) -------------
# openbrain-digest and openbrain-podcast load this file as an OPTIONAL env_file:
# the plane renders without it, but openbrain-digest exits at start while
# DIGEST_TO is empty (send-digest.ts), and the chain needs the OAuth files under
# OB1/secrets/google/ too. Other keys the code reads (LOCAL_LLM_*, LOCAL_EMBED_*,
# CONSIDERATIONS_*, ...) default in code or are set in the compose file.
